# Copy this file to .env and adjust values if needed.
# Currently all service URLs are configured directly in docker-compose.yml.

# MongoDB connection used by product, inventory, and order services
MONGODB_URL=mongodb://mongodb:27017

# Internal service URLs (used by cart-service)
PRODUCT_SERVICE_URL=http://product-service:8001
INVENTORY_SERVICE_URL=http://inventory-service:8003
PAYMENT_SERVICE_URL=http://payment-service:8004
ORDER_SERVICE_URL=http://order-service:8005
